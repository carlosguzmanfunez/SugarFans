{
  "rewrites": [{"source": "/api/reserve-session", "destination": "/api/live-token?reserveSession=session"}, {"source": "/api/reserve-session-webhook", "destination": "/api/live-token?reserveSession=webhook"}, {"source": "/sitemap.xml", "destination": "/api/usage?sitemap=1"}, {"source": "/control", "destination": "/control.html"}, {"source":"/((?!api/).*)","destination":"/index.html"}],
  "functions":{"api/moderate.ts":{"maxDuration":60},"api/payout-job.ts":{"maxDuration":180},"api/payout-review.ts":{"maxDuration":180},"api/prospects.ts":{"maxDuration":60},"api/usage.ts":{"maxDuration":60,"includeFiles":"docs/operations/manual-operacion.md"}},
  "crons":[
