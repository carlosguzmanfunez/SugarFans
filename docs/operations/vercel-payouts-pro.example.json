{
  "rewrites": [{"source":"/((?!api/).*)","destination":"/index.html"}],
  "functions":{"api/moderate.ts":{"maxDuration":60},"api/payout-job.ts":{"maxDuration":180},"api/payout-review.ts":{"maxDuration":180},"api/prospects.ts":{"maxDuration":60}},
  "crons":[
    {"path":"/api/usage","schedule":"0 14 * * *"},{"path":"/api/prospects","schedule":"0 13 * * *"},
    {"path":"/api/payout-review","schedule":"*/5 6-23 1,26-31 * *"},
    {"path":"/api/payout-review","schedule":"*/5 0-5 1-2,27-31 * *"},
    {"path":"/api/payout-review","schedule":"0 12 2-25 * *"}
  ],
  "headers":[{"source": "/(.*)", "headers": [{"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains"}, {"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"}]}]
}
